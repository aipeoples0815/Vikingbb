# Netlify Site configuration > Environment variables
# Strong PIN required on all generate requests; do not put API key in VITE_ variables
OPERATOR_PIN=change-me-to-a-long-random-pin
# Recommended: define this instead of typing key on kiosk. Both options supported.
OPENAI_API_KEY=
# Supported image API model; change only after checking account access.
OPENAI_IMAGE_MODEL=gpt-image-1
